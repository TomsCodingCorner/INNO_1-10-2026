<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Zorgagent" targetNamespace="https://example.invalid/zorgagent">
  <bpmn:process id="Process_Zorgagent" name="Synthetische WMO-voorbereiding en menselijke beslissing" isExecutable="false">
    <bpmn:startEvent id="start" name="Aanvraag ontvangen" />
    <bpmn:serviceTask id="validate" name="Gegevens en toestemming valideren" />
    <bpmn:exclusiveGateway id="valid" name="Geldig?" />
    <bpmn:serviceTask id="rejectlog" name="Validatiefout loggen zonder ruwe invoer" />
    <bpmn:sendTask id="rejectmsg" name="Duidelijke foutmelding (HTTP 400)" />
    <bpmn:endEvent id="rejectend" name="Niet verwerkt met AI" />
    <bpmn:serviceTask id="prepare" name="Token maken en AI-input minimaliseren" />
    <bpmn:serviceTask id="policy" name="Fictieve beleidsregels ophalen" />
    <bpmn:serviceTask id="ai" name="AI-stub maakt voorbereidend voorstel" />
    <bpmn:serviceTask id="assess" name="Risico, fairness en onderbouwing toetsen" />
    <bpmn:exclusiveGateway id="risk" name="Prioriteitsreview nodig?" />
    <bpmn:serviceTask id="priority" name="Zaak + audit opslaan: prioriteitsreview" />
    <bpmn:serviceTask id="standard" name="Zaak + audit opslaan: standaardreview" />
    <bpmn:exclusiveGateway id="merge" name="Reviewstatus opgeslagen" />
    <bpmn:sendTask id="receipt" name="Vast ontvangstbericht: AI helpt, mens beslist" />
    <bpmn:userTask id="review" name="Mens beoordeelt en motiveert beslissing" />
    <bpmn:serviceTask id="decision" name="Menselijk oordeel en audit-event opslaan" />
    <bpmn:endEvent id="end" name="Menselijke beslissing vastgelegd" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="validate" />
    <bpmn:sequenceFlow id="f2" sourceRef="validate" targetRef="valid" />
    <bpmn:sequenceFlow id="f3" sourceRef="valid" targetRef="rejectlog" name="Nee" />
    <bpmn:sequenceFlow id="f4" sourceRef="rejectlog" targetRef="rejectmsg" />
    <bpmn:sequenceFlow id="f5" sourceRef="rejectmsg" targetRef="rejectend" />
    <bpmn:sequenceFlow id="f6" sourceRef="valid" targetRef="prepare" name="Ja" />
    <bpmn:sequenceFlow id="f7" sourceRef="prepare" targetRef="policy" />
    <bpmn:sequenceFlow id="f8" sourceRef="policy" targetRef="ai" />
    <bpmn:sequenceFlow id="f9" sourceRef="ai" targetRef="assess" />
    <bpmn:sequenceFlow id="f10" sourceRef="assess" targetRef="risk" />
    <bpmn:sequenceFlow id="f11" sourceRef="risk" targetRef="priority" name="Ja" />
    <bpmn:sequenceFlow id="f12" sourceRef="risk" targetRef="standard" name="Nee" />
    <bpmn:sequenceFlow id="f13" sourceRef="priority" targetRef="merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="standard" targetRef="merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="merge" targetRef="receipt" />
    <bpmn:sequenceFlow id="f16" sourceRef="receipt" targetRef="review" />
    <bpmn:sequenceFlow id="f17" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f18" sourceRef="decision" targetRef="end" />
  </bpmn:process>
